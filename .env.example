# Copiar a .env y completar. Nunca subir .env al repositorio.

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (¡respáldala! sin ella no se pueden leer los certificados guardados)
ENCRYPTION_KEY=
DB_PASSWORD=cambia-esta-clave

# Se crea el superadmin solo la primera vez (mínimo 12 caracteres)
SUPERADMIN_EMAIL=admin@tuempresa.ec
SUPERADMIN_PASSWORD=

# 1 = pruebas (celcer), 2 = producción (cel)
SRI_AMBIENTE=1

# En producción conviene false
SWAGGER_ENABLED=true

APP_PORT=8080
